MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/fitrah
# Admin password login. Put the bcrypt hash here. SAFEST form: base64 of the hash
# (no "$" characters, survives every env host). Generate it with:
#   node -e "console.log(Buffer.from(process.argv[1],'utf8').toString('base64'))" -- '<your-bcrypt-hash>'
# The code accepts plain, backslash-escaped, or base64 forms automatically.
ADMIN_PASSWORD=your-bcrypt-hash-base64
JWT_SECRET=your-random-secret-at-least-32-chars
# Optional: where local backups go (node scripts/backup.mjs). Default: ../../fitrah-backups
# BACKUP_DIR=C:\path\you\choose
